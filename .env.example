# Copy to `.env` for local API work. Never commit `.env`.

# Render Postgres connection string (required on Render). Leave empty locally
# to use the in-memory store (data resets when the Node process exits).
DATABASE_URL=

# Shared team password for /probe write routes. Store in a password manager.
PROBE_SECRET=change-me

# Local Vite: talk to `npm run dev:server` instead of seed JSON.
# Leave VITE_API_BASE empty so the Vite proxy keeps login cookies same-origin.
# VITE_USE_API=true
# VITE_API_BASE=

# Google Maps (one Cloud project). Never commit real keys.
# Client: Maps JavaScript API. Used by the laptop app and the APK build.
# VITE_GOOGLE_MAPS_KEY=
# Server: Places API (New) + Geocoding API. Used by npm run dev:server and Render.
# GOOGLE_MAPS_SERVER_KEY=
